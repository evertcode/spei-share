---
import { es } from "../i18n/es";
import CopyButton from "./CopyButton.astro";

interface Props {
  showCopyLink?: boolean;
}

const { showCopyLink = true } = Astro.props;
---

<section id="share-actions" hidden aria-labelledby="share-heading" class="mt-14 animate-fade-up">
  <h2 id="share-heading" class="eyebrow text-ink-muted">
    {es.share.heading}
  </h2>

  <div class="mt-3 flex flex-wrap items-center gap-x-1 gap-y-3 border-y border-rule py-3">
    <CopyButton id="copy-all" label={es.share.copyAll} text={es.share.copyAll} />
    {showCopyLink && (
      <CopyButton id="copy-link" label={es.share.copyLink} text={es.share.copyLink} />
    )}
    <button
      id="native-share"
      type="button"
      class="group ml-auto inline-flex min-h-11 items-center gap-2 rounded-sm border border-transparent bg-ink px-4 text-sm font-medium text-paper transition-colors hover:bg-accent"
    >
      {es.share.native}
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M5 11 11 5M6 5h5v5"></path>
      </svg>
    </button>
  </div>
  <p id="share-status" class="mt-3 text-sm text-ink-muted empty:hidden" aria-live="polite"></p>

  <figure class="receipt-shadow mx-auto mt-10 w-full max-w-64">
    <div class="receipt-edges flex flex-col items-center gap-4 bg-paper-raised px-6 pt-8 pb-9 text-center">
      <div id="share-qr" role="img" aria-label={es.share.qr.alt} class="w-full max-w-44"></div>
      <a
        id="share-qr-download"
        download="spei-qr.svg"
        class="text-sm font-medium text-accent underline decoration-accent underline-offset-4 transition-colors hover:decoration-accent"
      >
        {es.share.qr.download}
      </a>
    </div>
  </figure>
</section>

<script>
  import { queryRequired } from "../dom/queryRequired";
  import { es } from "../i18n/es";
  import { formatTransferText } from "../spei/application/formatTransferText";
  import { generateQrSvg } from "../spei/application/generateQrSvg";
  import { shareTransfer } from "../spei/application/shareTransfer";
  import { subscribeToTransfer, type SharedTransfer } from "../spei/application/transferChannel";

  const section = queryRequired<HTMLElement>("#share-actions");
  const copyAllButton = queryRequired<HTMLButtonElement>("#copy-all", section);
  const copyLinkButton = section.querySelector<HTMLButtonElement>("#copy-link");
  const nativeShareButton = queryRequired<HTMLButtonElement>("#native-share", section);
  const status = queryRequired("#share-status", section);
  const qr = queryRequired("#share-qr", section);
  const qrDownload = queryRequired<HTMLAnchorElement>("#share-qr-download", section);

  let current: SharedTransfer | null = null;
  let qrObjectUrl: string | undefined;

  async function renderQr(url: URL): Promise<void> {
    const svg = await generateQrSvg(url);
    qr.innerHTML = svg;

    if (qrObjectUrl) URL.revokeObjectURL(qrObjectUrl);
    qrObjectUrl = URL.createObjectURL(new Blob([svg], { type: "image/svg+xml" }));
    qrDownload.href = qrObjectUrl;
  }

  async function show(transfer: SharedTransfer | null): Promise<void> {
    current = transfer;
    status.textContent = "";
    section.hidden = transfer === null;
    if (!transfer) return;

    const link = transfer.url.toString();
    copyAllButton.dataset.copyValue = `${formatTransferText(transfer.data)}\n\n${link}`;
    if (copyLinkButton) copyLinkButton.dataset.copyValue = link;
    await renderQr(transfer.url);
  }

  nativeShareButton.addEventListener("click", async () => {
    if (!current) return;

    try {
      const result = await shareTransfer(current.data, current.url);
      status.textContent = result === "copied" ? es.share.copiedFallback : "";
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      throw error;
    }
  });

  subscribeToTransfer((transfer) => void show(transfer));
</script>
