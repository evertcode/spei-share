---
import type { HTMLAttributes } from "astro/types";

interface Props {
  id: string;
  label: string;
  type?: "text" | "email";
  required?: boolean;
  placeholder?: string;
  inputmode?: HTMLAttributes<"input">["inputmode"];
  autocomplete?: HTMLAttributes<"input">["autocomplete"];
  mono?: boolean;
  hint?: boolean;
  showFor?: string;
  hidden?: boolean;
}

const {
  id,
  label,
  type = "text",
  required = true,
  placeholder,
  inputmode,
  autocomplete = "off",
  mono = false,
  hint = false,
  showFor,
  hidden = false,
} = Astro.props;
const describedBy = [hint ? `${id}-hint` : undefined, `${id}-error`].filter(Boolean).join(" ");
---

<div class="group/field" data-show-for={showFor} hidden={hidden}>
  <label
    for={id}
    class="eyebrow block text-ink-muted transition-colors group-focus-within/field:text-accent"
  >
    {label}
  </label>
  <input
    id={id}
    name={id}
    type={type}
    inputmode={inputmode}
    autocomplete={autocomplete}
    placeholder={placeholder}
    required={required}
    aria-describedby={describedBy}
    class:list={[
      "mt-1.5 w-full rounded-none border-0 border-b border-rule bg-transparent px-0 py-2 text-lg text-ink transition-[border-color,box-shadow] placeholder:text-ink-muted/45 hover:border-ink-muted focus:border-accent focus:shadow-[inset_0_-1px_0_var(--accent)] focus:outline-none aria-invalid:border-danger aria-invalid:shadow-[inset_0_-1px_0_var(--danger)]",
      { "font-mono text-base tracking-wide": mono },
    ]}
  />
  {hint && <p id={`${id}-hint`} class="mt-2 text-sm text-accent empty:hidden" aria-live="polite" />}
  <p id={`${id}-error`} class="mt-2 text-sm text-danger empty:hidden" aria-live="polite"></p>
</div>
