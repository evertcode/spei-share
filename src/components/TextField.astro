---
import type { HTMLAttributes } from "astro/types";

interface Props {
  id: string;
  label: string;
  type?: "text" | "email";
  required?: boolean;
  placeholder?: string;
  inputmode?: HTMLAttributes<"input">["inputmode"];
  autocomplete?: HTMLAttributes<"input">["autocomplete"];
  mono?: boolean;
  hint?: boolean;
  showFor?: string;
  hidden?: boolean;
}

const {
  id,
  label,
  type = "text",
  required = true,
  placeholder,
  inputmode,
  autocomplete = "off",
  mono = false,
  hint = false,
  showFor,
  hidden = false,
} = Astro.props;
const describedBy = [hint ? `${id}-hint` : undefined, `${id}-error`].filter(Boolean).join(" ");
---

<div class="space-y-1" data-show-for={showFor} hidden={hidden}>
  <label for={id} class="block text-sm font-medium">
    {label}
  </label>
  <input
    id={id}
    name={id}
    type={type}
    inputmode={inputmode}
    autocomplete={autocomplete}
    placeholder={placeholder}
    required={required}
    aria-describedby={describedBy}
    class:list={[
      "w-full rounded-md border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-teal-700 focus:ring-2 focus:ring-teal-700/30 focus:outline-none aria-invalid:border-red-600",
      { "font-mono": mono },
    ]}
  />
  {hint && <p id={`${id}-hint`} class="text-sm text-slate-600" aria-live="polite" />}
  <p id={`${id}-error`} class="text-sm text-red-700" aria-live="polite"></p>
</div>
