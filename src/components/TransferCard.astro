---
import { es } from "../i18n/es";
import type { OptionalField } from "../spei/domain/SpeiTransferData";
import CopyButton from "./CopyButton.astro";

type RowStyle = "text" | "figure" | "headline";

type Row = {
  field: "beneficiaryName" | "bankName" | "destination" | OptionalField;
  label: string;
  style: RowStyle;
  primary?: boolean;
};

// The payer needs the destination first, then the amount; the rest helps to verify.
const rows: Row[] = [
  { field: "destination", label: es.view.clabe.label, style: "headline", primary: true },
  { field: "amount", label: es.view.amount.label, style: "headline" },
  { field: "beneficiaryName", label: es.view.beneficiaryName.label, style: "text" },
  { field: "bankName", label: es.view.bank.label, style: "text" },
  { field: "concept", label: es.view.concept.label, style: "text" },
  { field: "rfc", label: es.view.rfc.label, style: "figure" },
  { field: "email", label: es.view.email.label, style: "text" },
];

const VALUE_CLASSES: Record<RowStyle, string> = {
  text: "text-lg text-ink [overflow-wrap:anywhere]",
  figure: "font-mono text-base tracking-wide text-ink [overflow-wrap:anywhere]",
  headline: "font-mono text-lg tracking-wide text-ink sm:text-2xl",
};
---

<article id="transfer-card" hidden class="animate-fade-up">
  <p class="mb-8 max-w-md text-lg leading-relaxed text-ink-muted">{es.view.instructions}</p>
  <div class="receipt-shadow print:[filter:none]">
    <div class="receipt-edges bg-paper-raised px-6 pt-10 pb-11 sm:px-9">
      <p class="eyebrow text-center text-accent">{es.view.receipt.eyebrow}</p>
      <hr class="mt-5 border-0 border-t border-dashed border-ink/25" />

      <dl class="divide-y divide-dotted divide-ink/25">
        {rows.map(({ field, label, style, primary }) => (
          <div class="py-4" data-row={field}>
            <dt class="eyebrow text-ink-muted">{label}</dt>
            <dd class="mt-1.5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 [&>button]:ml-auto">
              <span class:list={["min-w-0", VALUE_CLASSES[style]]} data-value />
              <CopyButton label={label} variant={primary ? "primary" : "quiet"} />
            </dd>
          </div>
        ))}
      </dl>

      <hr class="border-0 border-t border-dashed border-ink/25" />
      <p class="mt-5 text-center font-display text-base text-ink-muted italic">
        {es.view.receipt.verify}
      </p>
    </div>
  </div>

  <p class="mt-10 text-center text-sm text-ink-muted print:hidden">
    {es.view.createOwnPrompt}
    <a
      href="/"
      class="ml-1 inline-flex min-h-11 items-center font-medium text-accent underline decoration-accent underline-offset-4"
    >
      {es.view.createOwn}
    </a>
  </p>
</article>

<div id="invalid-link" hidden role="alert" class="border-l-2 border-danger py-1 pl-5">
  <p class="font-display text-2xl leading-snug text-ink">{es.view.invalidLink}</p>
  <p class="mt-2 text-ink-muted">{es.view.invalidLinkHelp}</p>
  <a
    href="/"
    class="mt-4 inline-block font-medium text-accent underline decoration-accent underline-offset-4 transition-colors hover:decoration-accent"
  >
    {es.view.createOwn}
  </a>
</div>

<script>
  import { queryRequired } from "../dom/queryRequired";
  import { es } from "../i18n/es";
  import { formatOptionalField, OPTIONAL_FIELDS } from "../spei/domain/optionalFields";
  import { formatTransferDestination } from "../spei/domain/transferDestination";
  import { InvalidShareLinkError } from "../spei/application/InvalidShareLinkError";
  import { decodeShareLink } from "../spei/application/shareLink";
  import { DESTINATION_LABELS } from "../spei/application/transferLabels";
  import { publishTransfer } from "../spei/application/transferChannel";

  type DisplayValue = { display: string; copy: string; label?: string };

  const card = queryRequired<HTMLElement>("#transfer-card");
  const invalidLink = queryRequired<HTMLElement>("#invalid-link");

  function fillRow(field: string, value: DisplayValue | undefined): void {
    const row = queryRequired<HTMLElement>(`[data-row="${field}"]`, card);
    row.hidden = value === undefined;
    if (!value) return;

    const { display, copy, label } = value;
    const copyButton = queryRequired<HTMLButtonElement>("[data-copy-button]", row);
    queryRequired("[data-value]", row).textContent = display;
    copyButton.dataset.copyValue = copy;
    if (label) {
      queryRequired("dt", row).textContent = label;
      copyButton.setAttribute("aria-label", `${es.copy.action} ${label}`);
      copyButton.dataset.copyLabel = label;
    }
  }

  function render(): void {
    try {
      const data = decodeShareLink(window.location.hash);

      fillRow("beneficiaryName", { display: data.beneficiaryName, copy: data.beneficiaryName });
      fillRow(
        "bankName",
        data.bankName ? { display: data.bankName, copy: data.bankName } : undefined,
      );
      fillRow("destination", {
        display: formatTransferDestination(data.destination),
        copy: data.destination.value,
        label: DESTINATION_LABELS[data.destination.type],
      });
      for (const field of OPTIONAL_FIELDS) {
        const value = data[field];
        fillRow(
          field,
          value ? { display: formatOptionalField(field, value), copy: value } : undefined,
        );
      }
      card.hidden = false;
      invalidLink.hidden = true;
      publishTransfer({ data, url: new URL(window.location.href) });
    } catch (error) {
      // Never leave a blank page: any failure is shown as an invalid link.
      if (!(error instanceof InvalidShareLinkError)) console.error(error);
      card.hidden = true;
      invalidLink.hidden = false;
      publishTransfer(null);
    }
  }

  render();
  window.addEventListener("hashchange", render);
</script>
