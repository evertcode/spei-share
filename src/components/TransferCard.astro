---
import { es } from "../i18n/es";
import CopyButton from "./CopyButton.astro";

type Row = { field: "beneficiaryName" | "bankName" | "clabe"; label: string; mono: boolean };

const rows: Row[] = [
  { field: "beneficiaryName", label: es.view.beneficiaryName.label, mono: false },
  { field: "bankName", label: es.view.bank.label, mono: false },
  { field: "clabe", label: es.view.clabe.label, mono: true },
];
---

<dl
  id="transfer-card"
  hidden
  class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white"
>
  {rows.map(({ field, label, mono }) => (
    <div class="flex items-center justify-between gap-4 px-4 py-3" data-row={field}>
      <div class="min-w-0">
        <dt class="text-sm text-slate-500">{label}</dt>
        <dd class:list={["font-medium break-all", { "font-mono": mono }]} data-value />
      </div>
      <CopyButton label={label} />
    </div>
  ))}
</dl>

<div
  id="invalid-link"
  hidden
  role="alert"
  class="space-y-4 rounded-lg border border-red-200 bg-red-50 p-4"
>
  <p class="text-red-800">{es.view.invalidLink}</p>
  <a href="/" class="font-medium text-teal-800 underline">
    {es.view.createOwn}
  </a>
</div>

<script>
  import { queryRequired } from "../dom/queryRequired";
  import { Clabe } from "../spei/domain/Clabe";
  import { InvalidShareLinkError } from "../spei/application/InvalidShareLinkError";
  import { decodeShareLink } from "../spei/application/shareLink";

  type DisplayValue = { display: string; copy: string };

  const card = queryRequired<HTMLElement>("#transfer-card");
  const invalidLink = queryRequired<HTMLElement>("#invalid-link");

  function fillRow(field: string, value: DisplayValue | undefined): void {
    const row = queryRequired<HTMLElement>(`[data-row="${field}"]`, card);
    row.hidden = value === undefined;
    if (!value) return;

    const { display, copy } = value;
    queryRequired("[data-value]", row).textContent = display;
    queryRequired<HTMLButtonElement>("[data-copy-button]", row).dataset.copyValue = copy;
  }

  function render(): void {
    try {
      const data = decodeShareLink(window.location.hash);
      const clabe = Clabe.create(data.destination.value);

      fillRow("beneficiaryName", { display: data.beneficiaryName, copy: data.beneficiaryName });
      fillRow(
        "bankName",
        data.bankName ? { display: data.bankName, copy: data.bankName } : undefined,
      );
      fillRow("clabe", { display: clabe.formatted(), copy: clabe.value });
      card.hidden = false;
      invalidLink.hidden = true;
    } catch (error) {
      if (!(error instanceof InvalidShareLinkError)) throw error;
      card.hidden = true;
      invalidLink.hidden = false;
    }
  }

  render();
  window.addEventListener("hashchange", render);
</script>
