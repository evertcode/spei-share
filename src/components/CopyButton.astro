---
import { es } from "../i18n/es";

type Variant = "quiet" | "primary";

interface Props {
  label: string;
  text?: string;
  value?: string;
  id?: string;
  variant?: Variant;
}

const { label, text, value = "", id, variant = "quiet" } = Astro.props;

const VARIANT_CLASSES: Record<Variant, string> = {
  quiet:
    "px-3 text-accent underline-offset-4 hover:bg-accent/10 hover:underline data-copied:no-underline",
  primary:
    "justify-center border border-transparent bg-ink px-5 text-paper hover:bg-accent max-sm:w-full",
};
---

<button
  type="button"
  id={id}
  data-copy-button
  data-copy-value={value}
  data-variant={variant}
  data-copy-label={label}
  aria-label={text ? undefined : `${es.copy.action} ${label}`}
  class:list={[
    "inline-flex min-h-11 shrink-0 items-center rounded-sm text-sm font-medium transition-colors duration-200 data-copied:bg-accent data-copied:text-accent-ink data-copy-failed:text-danger print:hidden",
    VARIANT_CLASSES[variant],
  ]}
>
  {text ?? es.copy.action}
</button>

<script>
  import { announce } from "../dom/announce";
  import { es } from "../i18n/es";

  const FEEDBACK_MS = 2000;
  const feedbackTimers = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();

  function showFeedback(button: HTMLButtonElement, text: string, state: "copied" | "copyFailed") {
    const idleText = button.dataset.idleText ?? button.textContent;
    button.dataset.idleText = idleText;

    clearTimeout(feedbackTimers.get(button));
    delete button.dataset.copied;
    delete button.dataset.copyFailed;

    button.textContent = text;
    button.dataset[state] = "";
    feedbackTimers.set(
      button,
      setTimeout(() => {
        button.textContent = idleText;
        delete button.dataset.copied;
        delete button.dataset.copyFailed;
      }, FEEDBACK_MS),
    );
  }

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-copy-button]");
    if (!button) return;

    try {
      await navigator.clipboard.writeText(button.dataset.copyValue ?? "");
      showFeedback(button, es.copy.done, "copied");
      announce(es.copy.doneFor.replace("{label}", button.dataset.copyLabel ?? ""));
    } catch {
      showFeedback(button, es.copy.failedShort, "copyFailed");
      announce(es.copy.failed);
    }
  });
</script>
