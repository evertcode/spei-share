---
import { es } from "../i18n/es";
import type { DestinationType } from "../spei/domain/SpeiTransferData";
import CopyButton from "./CopyButton.astro";
import TextField from "./TextField.astro";

type DestinationOption = { type: DestinationType; label: string };

const destinationOptions: DestinationOption[] = [
  { type: "clabe", label: es.form.destinationType.clabe },
  { type: "card", label: es.form.destinationType.card },
  { type: "account", label: es.form.destinationType.account },
];
---

<div
  id="draft-notice"
  role="status"
  hidden
  class="mb-10 flex flex-wrap items-center justify-between gap-3 border-y border-rule py-3 text-sm"
>
  <p class="flex items-center gap-2.5 text-ink-muted">
    <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    {es.form.draft.restored}
  </p>
  <button
    id="clear-draft"
    type="button"
    class="inline-flex min-h-11 items-center px-1 font-medium text-ink underline decoration-ink-muted underline-offset-4 transition-colors hover:decoration-ink"
  >
    {es.form.draft.clear}
  </button>
</div>

<form id="transfer-form" novalidate class="space-y-9">
  <TextField id="beneficiaryName" label={es.form.beneficiaryName.label} autocomplete="name" />

  <fieldset>
    <legend class="eyebrow mb-3 text-ink-muted">{es.form.destinationType.label}</legend>
    <div class="grid grid-cols-3 divide-x divide-ink-muted border border-ink-muted">
      {destinationOptions.map(({ type, label }) => (
        <label class="relative flex min-h-11 cursor-pointer items-center justify-center px-2 py-2.5 text-center text-sm leading-tight text-ink-muted transition-colors select-none hover:bg-ink/4 hover:text-ink has-checked:bg-ink has-checked:text-paper forced-colors:has-checked:font-bold forced-colors:has-checked:underline has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent">
          <input
            type="radio"
            name="destinationType"
            value={type}
            checked={type === "clabe"}
            class="absolute inset-0 m-0 cursor-pointer appearance-none opacity-0"
          />
          {label}
        </label>
      ))}
    </div>
  </fieldset>

  <TextField
    id="clabe"
    label={es.form.clabe.label}
    placeholder={es.form.clabe.placeholder}
    inputmode="numeric"
    mono
    hint
    showFor="clabe"
  />
  <TextField
    id="card"
    label={es.form.card.label}
    placeholder={es.form.card.placeholder}
    inputmode="numeric"
    autocomplete="cc-number"
    mono
    showFor="card"
    hidden
  />
  <TextField
    id="account"
    label={es.form.account.label}
    placeholder={es.form.account.placeholder}
    inputmode="numeric"
    mono
    showFor="account"
    hidden
  />
  <TextField id="bankName" label={es.form.bankName.label} showFor="card account" hidden />

  <fieldset class="space-y-9 border-0 border-t border-rule pt-1">
    <legend class="pr-4 font-display text-xl text-ink italic">{es.form.optional.heading}</legend>
    <TextField id="concept" label={es.form.concept.label} required={false} />
    <TextField
      id="amount"
      label={es.form.amount.label}
      inputmode="decimal"
      placeholder="0.00"
      required={false}
    />
    <TextField id="rfc" label={es.form.rfc.label} mono required={false} />
    <TextField
      id="email"
      label={es.form.email.label}
      type="email"
      autocomplete="email"
      required={false}
    />
  </fieldset>

  <button
    type="submit"
    class="group flex w-full items-center justify-between rounded-sm border border-transparent bg-ink px-5 py-4 text-base font-medium text-paper transition-colors hover:bg-accent"
  >
    {es.form.submit}
    <span
      aria-hidden="true"
      class="font-display text-2xl leading-none transition-transform group-hover:translate-x-1"
    >
      →
    </span>
  </button>
</form>

<section
  id="generated-link"
  hidden
  class="mt-10 animate-fade-up border border-dashed border-ink/25 bg-paper-raised px-5 py-4"
>
  <label for="generatedLink" class="eyebrow block text-accent">
    {es.form.generatedLink.label}
  </label>
  <div class="mt-2 flex items-center gap-3">
    <input
      id="generatedLink"
      type="url"
      readonly
      class="min-w-0 flex-1 truncate border-0 bg-transparent p-0 font-mono text-sm text-ink"
    />
    <CopyButton id="copy-generated-link" label={es.form.generatedLink.label} />
  </div>
</section>

<script>
  import { queryRequired } from "../dom/queryRequired";
  import { es } from "../i18n/es";
  import { Clabe } from "../spei/domain/Clabe";
  import { InvalidAccountNumberError } from "../spei/domain/InvalidAccountNumberError";
  import { InvalidAmountError } from "../spei/domain/InvalidAmountError";
  import { InvalidCardNumberError } from "../spei/domain/InvalidCardNumberError";
  import { InvalidClabeError } from "../spei/domain/InvalidClabeError";
  import { InvalidConceptError } from "../spei/domain/InvalidConceptError";
  import { InvalidEmailError } from "../spei/domain/InvalidEmailError";
  import { InvalidRfcError } from "../spei/domain/InvalidRfcError";
  import { findBankByCode } from "../spei/domain/banks";
  import type {
    DestinationType,
    OptionalField,
    OptionalTransferFields,
    SpeiTransferData,
    TransferDestination,
  } from "../spei/domain/SpeiTransferData";
  import { createOptionalField, OPTIONAL_FIELDS } from "../spei/domain/optionalFields";
  import { createTransferDestination, isDestinationType } from "../spei/domain/transferDestination";
  import { clearDraft, loadDraft, saveDraft } from "../spei/application/draftStorage";
  import { encodeShareLink } from "../spei/application/shareLink";
  import { publishTransfer } from "../spei/application/transferChannel";

  type FieldName = "beneficiaryName" | DestinationType | "bankName" | OptionalField;
  type FieldErrors = Partial<Record<FieldName, string>>;
  type ValidationResult = { ok: true; data: SpeiTransferData } | { ok: false; errors: FieldErrors };

  const FIELDS: readonly FieldName[] = [
    "beneficiaryName",
    "clabe",
    "card",
    "account",
    "bankName",
    ...OPTIONAL_FIELDS,
  ];

  const CLABE_ERRORS: Record<InvalidClabeError["reason"], string> = {
    length: es.errors.clabe.length,
    non_numeric: es.errors.clabe.nonNumeric,
    check_digit: es.errors.clabe.checkDigit,
  };
  const CARD_ERRORS: Record<InvalidCardNumberError["reason"], string> = {
    length: es.errors.card.length,
    non_numeric: es.errors.nonNumeric,
    checksum: es.errors.card.checksum,
  };
  const ACCOUNT_ERRORS: Record<InvalidAccountNumberError["reason"], string> = {
    length: es.errors.account.length,
    non_numeric: es.errors.nonNumeric,
  };

  const form = queryRequired<HTMLFormElement>("#transfer-form");
  const output = queryRequired<HTMLElement>("#generated-link");
  const linkInput = queryRequired<HTMLInputElement>("#generatedLink");
  const copyLinkButton = queryRequired<HTMLButtonElement>("#copy-generated-link");
  const clabeInput = queryRequired<HTMLInputElement>("#clabe", form);
  const clabeHint = queryRequired("#clabe-hint", form);
  const draftNotice = queryRequired<HTMLElement>("#draft-notice");
  const clearDraftButton = queryRequired<HTMLButtonElement>("#clear-draft", draftNotice);

  function destinationErrorMessage(error: unknown): string {
    if (error instanceof InvalidClabeError) return CLABE_ERRORS[error.reason];
    if (error instanceof InvalidCardNumberError) return CARD_ERRORS[error.reason];
    if (error instanceof InvalidAccountNumberError) return ACCOUNT_ERRORS[error.reason];
    throw error;
  }

  function optionalFieldErrorMessage(error: unknown): string {
    if (error instanceof InvalidConceptError) return es.errors.concept.tooLong;
    if (error instanceof InvalidAmountError) return es.errors.amount.invalid;
    if (error instanceof InvalidRfcError) return es.errors.rfc.invalid;
    if (error instanceof InvalidEmailError) return es.errors.email.invalid;
    throw error;
  }

  function selectedDestinationType(): DestinationType {
    const value = new FormData(form).get("destinationType");
    return isDestinationType(value) ? value : "clabe";
  }

  function tryCreateClabe(value: string): Clabe | undefined {
    try {
      return Clabe.create(value);
    } catch (error) {
      if (!(error instanceof InvalidClabeError)) throw error;
      return undefined;
    }
  }

  function bankNameOf(clabe: Clabe): string | undefined {
    return findBankByCode(clabe.bankCode)?.name;
  }

  function showDetectedBank(): void {
    const clabe = tryCreateClabe(clabeInput.value);
    if (!clabe) {
      clabeHint.textContent = "";
      return;
    }

    const bankName = bankNameOf(clabe);
    clabeHint.textContent = bankName
      ? es.form.clabe.detectedBank.replace("{bankName}", bankName)
      : es.form.clabe.unknownBank;
  }

  function showDestinationFields(): void {
    const type = selectedDestinationType();
    for (const field of form.querySelectorAll<HTMLElement>("[data-show-for]")) {
      field.hidden = !(field.dataset.showFor ?? "").split(" ").includes(type);
    }
  }

  function validate(formData: FormData): ValidationResult {
    const errors: FieldErrors = {};
    const type = selectedDestinationType();
    const beneficiaryName = String(formData.get("beneficiaryName") ?? "").trim();
    const rawDestination = String(formData.get(type) ?? "").trim();

    if (beneficiaryName === "") errors.beneficiaryName = es.errors.required;

    let destination: TransferDestination | undefined;
    if (rawDestination === "") {
      errors[type] = es.errors.required;
    } else {
      try {
        destination = createTransferDestination(type, rawDestination);
      } catch (error) {
        errors[type] = destinationErrorMessage(error);
      }
    }

    let bankName: string | undefined;
    if (type === "clabe") {
      bankName = destination ? bankNameOf(Clabe.create(destination.value)) : undefined;
    } else {
      bankName = String(formData.get("bankName") ?? "").trim();
      if (bankName === "") errors.bankName = es.errors.required;
    }

    const optionalFields: OptionalTransferFields = {};
    for (const field of OPTIONAL_FIELDS) {
      const raw = String(formData.get(field) ?? "").trim();
      if (raw === "") continue;
      try {
        optionalFields[field] = createOptionalField(field, raw);
      } catch (error) {
        errors[field] = optionalFieldErrorMessage(error);
      }
    }

    if (!destination || Object.keys(errors).length > 0) return { ok: false, errors };

    const data: SpeiTransferData = { beneficiaryName, destination, ...optionalFields };
    if (bankName) data.bankName = bankName;

    return { ok: true, data };
  }

  function showErrors(errors: FieldErrors): void {
    for (const field of FIELDS) {
      const message = errors[field] ?? "";
      queryRequired(`#${field}-error`, form).textContent = message;
      queryRequired<HTMLInputElement>(`#${field}`, form).setAttribute(
        "aria-invalid",
        String(message !== ""),
      );
    }
  }

  function setFieldValue(field: FieldName, value: string | undefined): void {
    queryRequired<HTMLInputElement>(`#${field}`, form).value = value ?? "";
  }

  function fillForm(data: SpeiTransferData): void {
    const { type, value } = data.destination;
    queryRequired<HTMLInputElement>(
      `input[name="destinationType"][value="${type}"]`,
      form,
    ).checked = true;
    setFieldValue("beneficiaryName", data.beneficiaryName);
    setFieldValue(type, value);
    if (type !== "clabe") setFieldValue("bankName", data.bankName);
    for (const field of OPTIONAL_FIELDS) setFieldValue(field, data[field]);
  }

  function restoreDraft(): void {
    const draft = loadDraft();
    if (!draft) return;

    fillForm(draft);
    draftNotice.hidden = false;
  }

  function resetForm(): void {
    clearDraft();
    form.reset();
    draftNotice.hidden = true;
    output.hidden = true;
    showErrors({});
    showDestinationFields();
    showDetectedBank();
    publishTransfer(null);
  }

  clabeInput.addEventListener("input", showDetectedBank);
  clearDraftButton.addEventListener("click", resetForm);
  form.addEventListener("change", (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === "destinationType") {
      showDestinationFields();
      showErrors({});
    }
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const result = validate(new FormData(form));

    if (!result.ok) {
      showErrors(result.errors);
      output.hidden = true;
      publishTransfer(null);
      return;
    }

    showErrors({});
    const url = encodeShareLink(result.data, new URL(window.location.origin));
    linkInput.value = url.toString();
    copyLinkButton.dataset.copyValue = url.toString();
    output.hidden = false;
    saveDraft(result.data);
    publishTransfer({ data: result.data, url });
  });

  restoreDraft();
  showDestinationFields();
  showDetectedBank();
</script>
