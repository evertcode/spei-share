---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareActions from "../components/ShareActions.astro";
import TransferForm from "../components/TransferForm.astro";
import { es } from "../i18n/es";

const [headingLead = ""] = es.home.heading.split(es.home.headingEmphasis);
---

<BaseLayout>
  <header class="mb-12 max-w-xl">
    <p class="eyebrow mb-5 flex items-center gap-3 text-accent">
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      {es.home.eyebrow}
    </p>
    <h1 class="font-display text-5xl leading-[1.02] font-normal tracking-tight text-ink sm:text-6xl">
      {headingLead}
      <em class="font-light text-accent">{es.home.headingEmphasis}</em>
    </h1>
    <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-muted">{es.home.subheading}</p>
  </header>
  <TransferForm />
  <ShareActions showCopyLink={false} />
</BaseLayout>
