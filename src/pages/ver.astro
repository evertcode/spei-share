---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareActions from "../components/ShareActions.astro";
import TransferCard from "../components/TransferCard.astro";
import { es } from "../i18n/es";
---

<BaseLayout title={es.view.heading}>
  <h1 class="mb-10 font-display text-4xl leading-tight font-normal tracking-tight sm:text-5xl">
    {es.view.heading}
  </h1>
  <noscript>
    <p class="border-l-2 border-danger py-1 pl-5 font-display text-2xl leading-snug">
      {es.view.noscript}
    </p>
  </noscript>
  <TransferCard />
  <ShareActions />
</BaseLayout>
